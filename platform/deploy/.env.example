# ============================================================
# SuperPonto v2 — configuração da API
# ============================================================

# --- Banco: Supabase (padrão) -------------------------------
# Pooler em modo sessão (porta 5432) do Supabase: Settings > Database > Connection string > Session.
# A API usa o papel superponto_api (sujeito à RLS), criado por scripts/db-setup.sh.
DATABASE_URL=postgresql://superponto_api.SEU_PROJETO:SENHA_DA_API@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=superponto
# Papel dono (postgres), usado só para migrar e criar papéis.
MIGRATION_DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA_DO_BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=superponto

# --- Banco: VPS (quando migrar) -----------------------------
# DATABASE_URL=postgresql://superponto_api:SENHA_DA_API@db:5432/superponto?schema=superponto
# MIGRATION_DATABASE_URL=postgresql://postgres:SENHA_DO_BANCO@db:5432/superponto?schema=superponto
POSTGRES_PASSWORD=

# --- API -----------------------------------------------------
APP_URL=https://app.seu-dominio.com.br
API_URL=https://api.seu-dominio.com.br
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# openssl rand -base64 32 — cifra das digitais (sem ela, o cadastro de digitais fica desativado).
# Guarde uma cópia segura: perder esta chave torna as digitais gravadas ilegíveis.
BIOMETRIC_ENCRYPTION_KEY=
CORS_ORIGINS=

# --- E-mail (recuperação de senha) ---------------------------
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SuperPonto <nao-responda@seu-dominio.com.br>

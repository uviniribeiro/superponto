model AdministrativeAppointment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  employmentId String?  @map("employment_id") @db.Uuid
  startsAt     DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(6)
  title        String
  status       String   @default("SCHEDULED")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room ConsultationRoom @relation(fields: [roomId], references: [id])

  @@index([tenantId, roomId, startsAt])
  @@map("medical_appointments")
}

// -----------------------------------------------------------------------------
// Gestão operacional
// -----------------------------------------------------------------------------

model OperationalActivity {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  assignments OperationalAssignment[]

  @@index([tenantId, unitId, startsAt])
  @@map("operational_activities")
}

model OperationalAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  employmentId String    @map("employment_id") @db.Uuid
  teamId       String?   @map("team_id") @db.Uuid
  activityId   String?   @map("activity_id") @db.Uuid
  workDate     DateTime  @map("work_date") @db.Date
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(6)

  employment Employment           @relation(fields: [employmentId], references: [id])
  team       OperationalTeam?     @relation(fields: [teamId], references: [id])
  activity   OperationalActivity? @relation(fields: [activityId], references: [id])

  @@index([tenantId, workDate])
  @@map("operational_assignments")
}

model OperationalOccurrence {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  unitId        String           @map("unit_id") @db.Uuid
  type          OccurrenceType
  title         String
  description   String?
  occurredAt    DateTime         @map("occurred_at") @db.Timestamptz(6)
  status        OccurrenceStatus @default(OPEN)
  responsibleId String?          @map("responsible_id") @db.Uuid
  employmentId  String?          @map("employment_id") @db.Uuid
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  events OperationalEvent[]

  @@index([tenantId, unitId, status])
  @@map("operational_occurrences")
}

/// Histórico de tratamento de uma ocorrência operacional.
model OperationalEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  occurrenceId String   @map("occurrence_id") @db.Uuid
  action       String
  notes        String?
  actorUserId  String   @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  occurrence OperationalOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurrenceId])
  @@map("operational_events")
}

// -----------------------------------------------------------------------------
// Equipamentos (catálogo global + dispositivos do cliente)
// -----------------------------------------------------------------------------

model DeviceManufacturer {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @unique
  website String?

  models DeviceModel[]

  @@map("device_manufacturers")
}

model DeviceModel {
  id             String         @id @default(uuid()) @db.Uuid
  manufacturerId String         @map("manufacturer_id") @db.Uuid
  name           String
  category       DeviceCategory
  protocols      String[]
  capabilities   Json           @default("{}")

  manufacturer  DeviceManufacturer   @relation(fields: [manufacturerId], references: [id])
  adapters      DeviceAdapter[]
  homologations DeviceHomologation[]
  devices       Device[]

  @@unique([manufacturerId, name])
  @@map("device_models")
}

model DeviceAdapter {
  id        String @id @default(uuid()) @db.Uuid
  modelId   String @map("model_id") @db.Uuid
  key       String
  version   String
  transport String

  model DeviceModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, key, version])
  @@map("device_adapters")
}

/// Matriz de compatibilidade: só "HOMOLOGATED" após teste com equipamento real.
model DeviceHomologation {
  id             String             @id @default(uuid()) @db.Uuid
  modelId        String             @map("model_id") @db.Uuid
  firmware       String
  adapterKey     String             @map("adapter_key")
  adapterVersion String             @map("adapter_version")
  connection     String
  features       Json               @default("{}")
  status         HomologationStatus @default(NOT_TESTED)
  testedAt       DateTime?          @map("tested_at") @db.Timestamptz(6)
  limitations    String?

  model DeviceModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, firmware, adapterKey, adapterVersion])
  @@map("device_homologations")
}

model Device {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  companyId              String              @map("company_id") @db.Uuid
  unitId                 String?             @map("unit_id") @db.Uuid
  modelId                String?             @map("model_id") @db.Uuid
  commServerId           String?             @map("comm_server_id") @db.Uuid
  name                   String
  serialNumber           String?             @map("serial_number")
  firmware               String?
  host                   String?
  port                   Int?
  protocol               String?
  internalCode           String?             @map("internal_code")
  usage                  String[]            @default(["TIME"])
  ordinance              RepOrdinance?
  /// fuso do equipamento: o AFD da Portaria 1.510 não traz fuso
  timezone               String              @default("America/Sao_Paulo")
  status                 DeviceStatus        @default(PENDING)
  lastSeenAt             DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  lastSyncAt             DateTime?           @map("last_sync_at") @db.Timestamptz(6)
  adapterVersion         String?             @map("adapter_version")
  // Credenciais do equipamento ficam cifradas (nunca retornam ao frontend).
  credentialsEnc         String?             @map("credentials_enc")
  /// grupo de REP (ex.: "Portaria", "Bloco B") para enviar comandos a vários de uma vez
  groupName              String?             @map("group_name")
  /// número de fabricação do REP (17 dígitos, Portaria 671)
  repNumber              String?             @map("rep_number")
  manufacturer           String?
  modelName              String?             @map("model_name")
  /// coleta automática a cada N minutos (o agente local busca os registros)
  collectIntervalMinutes Int?                @map("collect_interval_minutes")
  /// e-mails avisados quando o equipamento fica sem comunicação ou volta
  alertEmails            String[]            @default([]) @map("alert_emails")
  /// SHA-256 da chave do agente local (a chave só aparece uma vez, ao gerar)
  agentKeyHash           String?             @unique @map("agent_key_hash")
  roster                 DeviceRosterEntry[]
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)

  company            Company              @relation(fields: [companyId], references: [id])
  unit               CompanyUnit?         @relation(fields: [unitId], references: [id])
  model              DeviceModel?         @relation(fields: [modelId], references: [id])
  commServer         CommunicationServer? @relation(fields: [commServerId], references: [id])
  identifiers        DeviceIdentifier[]
  events             DeviceEvent[]
  logs               DeviceLog[]
  syncJobs           DeviceSyncJob[]
  timeRecords        TimeRecord[]
  accessEvents       AccessEvent[]
  biometricsCaptured BiometricTemplate[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId, companyId, status])
  @@index([commServerId])
  @@map("devices")
}

/// Identificador do vínculo no equipamento (matrícula, cartão, RFID, referência biométrica).
/// Templates biométricos não são armazenados aqui: apenas a referência no equipamento.
model DeviceIdentifier {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  employmentId String               @map("employment_id") @db.Uuid
  deviceId     String?              @map("device_id") @db.Uuid
  type         DeviceIdentifierType
  value        String
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  employment Employment @relation(fields: [employmentId], references: [id])
  device     Device?    @relation(fields: [deviceId], references: [id])

  @@unique([tenantId, type, value, deviceId])
  @@index([tenantId, employmentId])
  @@map("device_identifiers")
}

/// Evento bruto recebido do equipamento (ponto, acesso, status). Ponto ≠ acesso físico.
model DeviceEvent {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  deviceId    String          @map("device_id") @db.Uuid
  kind        DeviceEventKind
  occurredAt  DateTime        @map("occurred_at") @db.Timestamptz(6)
  identifier  String?
  nsr         BigInt?
  payload     Json
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(6)
  commEventId String?         @map("comm_event_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, kind, nsr, occurredAt])
  @@index([tenantId, deviceId, occurredAt])
  @@map("device_events")
}

model DeviceLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  level     String
  message   String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId, deviceId, createdAt])
  @@map("device_logs")
}

/// Comando/sincronização para o equipamento (enviado via Communication Server).
model DeviceSyncJob {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  action      String
  payload     Json      @default("{}")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  createdById String?   @map("created_by_id") @db.Uuid

  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId, deviceId, status])
  @@map("device_sync_jobs")
}

/// Evento de acesso físico (porta, catraca). Separado de TimeRecord por finalidade.
model AccessEvent {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  deviceId     String          @map("device_id") @db.Uuid
  employmentId String?         @map("employment_id") @db.Uuid
  kind         DeviceEventKind
  occurredAt   DateTime        @map("occurred_at") @db.Timestamptz(6)
  granted      Boolean
  direction    String?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  device     Device      @relation(fields: [deviceId], references: [id])
  employment Employment? @relation(fields: [employmentId], references: [id])

  @@index([tenantId, deviceId, occurredAt])
  @@map("access_events")
}

// -----------------------------------------------------------------------------
// Communication Server
// -----------------------------------------------------------------------------

model CommunicationServer {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String?      @map("tenant_id") @db.Uuid
  name              String
  identifier        String       @unique
  publicIp          String?      @map("public_ip")
  domain            String?
  port              Int?
  protocol          String       @default("https")
  status            ServerStatus @default(PENDING)
  version           String?
  lastSeenAt        DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  allowedCompanyIds String[]     @map("allowed_company_ids") @db.Uuid
  allowedUnitIds    String[]     @map("allowed_unit_ids") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant?                         @relation(fields: [tenantId], references: [id])
  credentials CommunicationServerCredential[]
  devices     Device[]
  events      CommunicationEvent[]
  history     CommunicationSyncHistory[]
  logs        CommunicationLog[]

  @@map("communication_servers")
}

/// Credencial do servidor: só o hash do segredo; rotação com validade.
model CommunicationServerCredential {
  id              String    @id @default(uuid()) @db.Uuid
  serverId        String    @map("server_id") @db.Uuid
  keyId           String    @unique @map("key_id")
  secretHash      String    @map("secret_hash")
  certFingerprint String?   @map("cert_fingerprint")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@map("communication_server_credentials")
}

/// Lote recebido do Communication Server; idempotente por (serverId, batchId).
model CommunicationEvent {
  id             String    @id @default(uuid()) @db.Uuid
  serverId       String    @map("server_id") @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  batchId        String    @map("batch_id")
  kind           String
  itemCount      Int       @map("item_count")
  acceptedCount  Int       @default(0) @map("accepted_count")
  duplicateCount Int       @default(0) @map("duplicate_count")
  rejectedCount  Int       @default(0) @map("rejected_count")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  errors         Json      @default("[]")

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@unique([serverId, batchId])
  @@index([serverId, receivedAt])
  @@map("communication_events")
}

model CommunicationSyncHistory {
  id        String   @id @default(uuid()) @db.Uuid
  serverId  String   @map("server_id") @db.Uuid
  direction String
  summary   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])
  @@map("communication_sync_history")
}

model CommunicationLog {
  id        String   @id @default(uuid()) @db.Uuid
  serverId  String   @map("server_id") @db.Uuid
  level     String
  message   String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])
  @@map("communication_logs")
}

// -----------------------------------------------------------------------------
// Usuários, perfis, permissões e auditoria
// -----------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String?    @map("tenant_id") @db.Uuid
  personId           String?    @unique @map("person_id") @db.Uuid
  email              String     @unique
  /// login da v1: usuário + CNPJ da empresa + senha (único dentro do cliente)
  username           String?
  passwordHash       String?    @map("password_hash")
  displayName        String     @map("display_name")
  isPlatformAdmin    Boolean    @default(false) @map("is_platform_admin")
  /// Usuário de suporte e treinamento da equipe SuperPonto dentro do cliente: oculto da lista
  /// para os usuários do cliente e não editável por ninguém do cliente.
  isSupport          Boolean    @default(false) @map("is_support")
  isActive           Boolean    @default(true) @map("is_active")
  /// dias da semana com acesso (0 = domingo … 6 = sábado); vazio = todos os dias
  accessWeekdays     Int[]      @default([]) @map("access_weekdays")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  /// LOCAL = senha no SuperPonto; LDAP = senha conferida no diretório do cliente (AD/OpenLDAP)
  authSource         AuthSource @default(LOCAL) @map("auth_source")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLogins       Int        @default(0) @map("failed_logins")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant?                  @relation(fields: [tenantId], references: [id])
  person        Person?                  @relation(fields: [personId], references: [id])
  roles         UserRole[]
  accessBlocks  UserAccessBlock[]        @relation("BlockedUser")
  notifications Notification[]
  preferences   NotificationPreference[]

  @@map("users")

  @@unique([tenantId, username])
}

// -----------------------------------------------------------------------------
// Estado de autenticação (@nestjs/authentication). Tokens, sessões e links são
// guardados como SHA-256; segredos TOTP chegam cifrados (AES-256-GCM).
// -----------------------------------------------------------------------------

model AuthSession {
  id           String   @id
  userId       String   @map("user_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(6)
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id              String    @id
  familyId        String    @map("family_id")
  userId          String    @map("user_id")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  familyExpiresAt DateTime  @map("family_expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  claims          Json?
  revoked         Boolean   @default(false)

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
  @@map("auth_refresh_tokens")
}

model MfaAuthenticator {
  userId        String  @id @map("user_id")
  secret        String
  confirmed     Boolean
  pendingSecret String? @map("pending_secret")
  lastUsedStep  Int?    @map("last_used_step")

  @@map("auth_mfa_authenticators")
}

model MfaRecoveryCode {
  userId   String @map("user_id")
  codeHash String @map("code_hash")

  @@id([userId, codeHash])
  @@map("auth_mfa_recovery_codes")
}

model MfaFailure {
  id       Int      @id @default(autoincrement())
  userId   String   @map("user_id")
  failedAt DateTime @map("failed_at") @db.Timestamptz(6)

  @@index([userId, failedAt])
  @@index([failedAt])
  @@map("auth_mfa_failures")
}

model EmailToken {
  id          String   @id
  purpose     String
  userId      String   @map("user_id")
  email       String
  fingerprint String?
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_email_tokens")
}

/// Perfil: tenantId nulo = perfil de sistema (modelo), copiado/usado por todos.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// Permissão global no formato "modulo.recurso:acao" (ex.: "time.records:approve").
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Papel do usuário com escopo (tenant inteiro, empresa, unidade ou departamento).
model UserRole {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  roleId       String          @map("role_id") @db.Uuid
  tenantId     String?         @map("tenant_id") @db.Uuid
  scope        PermissionScope @default(TENANT)
  companyId    String?         @map("company_id") @db.Uuid
  unitId       String?         @map("unit_id") @db.Uuid
  departmentId String?         @map("department_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope, companyId, unitId, departmentId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

/// Trilha de auditoria (somente inserção; gatilho bloqueia alteração e exclusão).
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String?     @map("tenant_id") @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  entity      String
  entityId    String?     @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?     @map("user_agent")
  requestId   String?     @map("request_id")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Notificações
// -----------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  type    String
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

// -----------------------------------------------------------------------------
// SaaS: planos, assinaturas e cobrança
// -----------------------------------------------------------------------------

model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  name       String
  priceCents Int      @map("price_cents")
  currency   String   @default("BRL")
  interval   String   @default("month")
  isPublic   Boolean  @default(true) @map("is_public")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Limite ou módulo do plano (ex.: "limit.employments" = 100, "module.health" = true).
model PlanFeature {
  id     String @id @default(uuid()) @db.Uuid
  planId String @map("plan_id") @db.Uuid
  key    String
  value  Json

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_features")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAt           DateTime?          @map("cancel_at") @db.Timestamptz(6)
  addons             Json               @default("[]")
  overrides          Json               @default("{}")
  externalId         String?            @map("external_id")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  plan   Plan           @relation(fields: [planId], references: [id])
  events BillingEvent[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model BillingEvent {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  provider       String
  externalId     String    @map("external_id")
  type           String
  amountCents    Int?      @map("amount_cents")
  payload        Json
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, externalId])
  @@map("billing_events")
}

/// Digital do trabalhador: somente o template (nunca a imagem), cifrado com AES-256-GCM pela API.
/// Dado pessoal sensível (LGPD, art. 11): acesso por permissão própria e toda operação auditada.
model BiometricTemplate {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  employmentId     String          @map("employment_id") @db.Uuid
  /// 0 = polegar direito … 9 = mínimo esquerdo (ISO/IEC 19794-2)
  finger           Int             @db.SmallInt
  format           BiometricFormat
  templateEnc      String          @map("template_enc")
  /// SHA-256 do template em claro, para evitar duplicidade sem decifrar
  templateSha256   String          @map("template_sha256")
  quality          Int?            @db.SmallInt
  capturedDeviceId String?         @map("captured_device_id") @db.Uuid
  capturedById     String?         @map("captured_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(6)

  employment     Employment @relation(fields: [employmentId], references: [id])
  capturedDevice Device?    @relation(fields: [capturedDeviceId], references: [id])

  @@index([tenantId, employmentId])
  @@map("biometric_templates")
}

// -----------------------------------------------------------------------------
// Feriados
// -----------------------------------------------------------------------------

enum HolidayScope {
  NATIONAL
  STATE
  MUNICIPAL
  COMPANY

  @@map("holiday_scope")
}

enum HolidayKind {
  HOLIDAY
  OPTIONAL

  @@map("holiday_kind")
}

/// Catálogo global de feriados por ano, gerado automaticamente (01/01 e na subida da API).
/// uf e ibge vazios ('') nos nacionais, para a chave única funcionar.
model PublicHoliday {
  id        String       @id @default(uuid()) @db.Uuid
  date      DateTime     @db.Date
  year      Int          @db.SmallInt
  name      String
  scope     HolidayScope
  kind      HolidayKind
  uf        String       @default("")
  ibge      String       @default("")
  basis     String?
  /// base inicial do SuperPonto: conferir com a lei local
  review    Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([date, scope, uf, ibge, name])
  @@index([year, scope, uf, ibge])
  @@map("public_holidays")
}

/// Feriado próprio da empresa (municipal fora da base, aniversário da empresa etc.), repetido todo ano.
model CompanyHolidayRule {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  name      String
  kind      HolidayKind @default(HOLIDAY)
  month     Int?        @db.SmallInt
  day       Int?        @db.SmallInt
  /// feriado móvel: CARNIVAL_MONDAY, CARNIVAL_TUESDAY, ASH_WEDNESDAY, GOOD_FRIDAY, CORPUS_CHRISTI
  movable   String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([tenantId, companyId])
  @@map("company_holiday_rules")
}

/// Decisão da empresa para uma data: trabalhar num ponto facultativo ou folgar num dia comum.
model CompanyHolidayOverride {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  date      DateTime @db.Date
  workday   Boolean
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([tenantId, companyId])
  @@map("company_holiday_overrides")
}

// -----------------------------------------------------------------------------
// Cadastros auxiliares da estrutura (por cliente)
// -----------------------------------------------------------------------------

/// Função exercida (diferente do cargo): ex. "Recepcionista" num cargo de "Auxiliar administrativo".
model JobFunction {

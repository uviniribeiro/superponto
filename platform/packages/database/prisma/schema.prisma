// -----------------------------------------------------------------------------
// Ponto eletrônico, apuração e banco de horas
// -----------------------------------------------------------------------------

/// Marcação ORIGINAL. Imutável (gatilho no banco bloqueia UPDATE/DELETE).
model TimeRecord {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  employmentId    String           @map("employment_id") @db.Uuid
  recordedAt      DateTime         @map("recorded_at") @db.Timestamptz(6)
  timezone        String           @default("America/Sao_Paulo")
  type            TimeRecordType   @default(UNCLASSIFIED)
  source          TimeRecordSource
  deviceId        String?          @map("device_id") @db.Uuid
  deviceNsr       BigInt?          @map("device_nsr")
  commEventId     String?          @map("comm_event_id") @db.Uuid
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  accuracyM       Int?             @map("accuracy_m")
  capturedOffline Boolean          @default(false) @map("captured_offline")
  syncedAt        DateTime?        @map("synced_at") @db.Timestamptz(6)
  // Integridade: hash encadeado (registro anterior do mesmo vínculo + conteúdo).
  hash            String
  previousHash    String?          @map("previous_hash")
  idempotencyKey  String           @map("idempotency_key")
  receivedAt      DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  /// REP-P (navegador/app): NSR sequencial por empresa e hash encadeado do registro tipo 7 do AFD
  repPCompanyId   String?          @map("rep_p_company_id") @db.Uuid
  repPNsr         BigInt?          @map("rep_p_nsr")
  repPHash        String?          @map("rep_p_hash")

  employment  Employment             @relation(fields: [employmentId], references: [id])
  device      Device?                @relation(fields: [deviceId], references: [id])
  adjustments TimeRecordAdjustment[]

  @@unique([tenantId, idempotencyKey])
  @@unique([repPCompanyId, repPNsr])
  @@index([tenantId, employmentId, recordedAt])
  @@index([tenantId, deviceId, deviceNsr])
  @@map("time_records")
}

/// Correção auditável: inclui marcação, desconsidera ou reclassifica, sempre com justificativa.
model TimeRecordAdjustment {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  employmentId  String          @map("employment_id") @db.Uuid
  timeRecordId  String?         @map("time_record_id") @db.Uuid
  kind          AdjustmentKind
  recordedAt    DateTime?       @map("recorded_at") @db.Timestamptz(6)
  newType       TimeRecordType? @map("new_type")
  justification String
  status        ApprovalStatus  @default(PENDING)
  requestId     String?         @map("request_id") @db.Uuid
  createdById   String          @map("created_by_id") @db.Uuid
  decidedById   String?         @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  timeRecord TimeRecord?  @relation(fields: [timeRecordId], references: [id])
  request    TimeRequest? @relation(fields: [requestId], references: [id])

  @@index([tenantId, employmentId, createdAt])
  @@map("time_record_adjustments")
}

/// Resultado da apuração diária por vínculo (recalculável a partir das marcações + ajustes).
model TimeCalculation {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  employmentId      String   @map("employment_id") @db.Uuid
  workDate          DateTime @map("work_date") @db.Date
  expectedMinutes   Int      @map("expected_minutes")
  workedMinutes     Int      @map("worked_minutes")
  balanceMinutes    Int      @map("balance_minutes")
  overtime          Json
  nightMinutes      Int      @default(0) @map("night_minutes")
  lateMinutes       Int      @default(0) @map("late_minutes")
  earlyLeaveMinutes Int      @default(0) @map("early_leave_minutes")
  absenceMinutes    Int      @default(0) @map("absence_minutes")
  breakMinutes      Int      @default(0) @map("break_minutes")
  flags             Json     @default("[]")
  /// resultado completo do dia (marcações usadas, intervalos, faixas de extra) para o espelho do período fechado
  details           Json?
  engineVersion     String   @map("engine_version")
  calculatedAt      DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)

  employment Employment @relation(fields: [employmentId], references: [id])

  @@unique([employmentId, workDate])
  @@index([tenantId, workDate])
  @@map("time_calculations")
}


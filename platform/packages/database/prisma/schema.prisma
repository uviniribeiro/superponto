// =============================================================================
// SuperPonto v2 — modelo de dados (PostgreSQL + Prisma 7)
//
// Convenções
//  - Chaves primárias: UUID técnico (id). Matrícula, CPF, PIS, CRM nunca são PK.
//  - Multi-tenant: toda tabela de dados de cliente tem tenantId (isolamento por RLS
//    no PostgreSQL + filtro obrigatório na API). Tabelas globais: planos, fabricantes,
//    modelos de equipamento, permissões.
//  - Exclusão lógica: deletedAt nas entidades cadastrais.
//  - Marcações de ponto são imutáveis: correções são TimeRecordAdjustment.
//  - Colunas/tabelas em snake_case no banco (@map/@@map gerados por scripts/snake-case.mjs).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

enum CompanySegment {
  GENERAL
  EDUCATION
  HEALTH
  PUBLIC_SECTOR
  INDUSTRY
  RETAIL
  SERVICES

  @@map("company_segment")
}

enum UnitType {
  HEADQUARTERS
  BRANCH
  SCHOOL
  HOSPITAL
  CLINIC
  UPA
  UBS
  LABORATORY
  OFFICE
  OPERATIONAL_SITE
  OTHER

  @@map("unit_type")
}

enum PersonStatus {
  ACTIVE
  INACTIVE

  @@map("person_status")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED

  @@map("employment_status")
}

enum ContractType {
  CLT
  STATUTORY
  TEMPORARY
  INTERN
  APPRENTICE
  CONTRACTOR
  SERVICE_PROVIDER
  VOLUNTEER
  OTHER

  @@map("contract_type")
}

enum ProfessionalCategory {
  GENERAL
  TEACHER
  PHYSICIAN
  NURSE
  NURSING_TECHNICIAN
  NURSING_ASSISTANT
  PHYSIOTHERAPIST
  PSYCHOLOGIST
  PHARMACIST
  DENTIST
  NUTRITIONIST
  SOCIAL_WORKER
  OTHER_HEALTH

  @@map("professional_category")
}

enum ScheduleType {
  FIXED
  FLEXIBLE
  SHIFT_12X36
  SHIFT_6X1
  SHIFT_5X2
  SHIFT_4X2
  ROTATING
  CUSTOM
  ON_CALL
  TEACHING

  @@map("schedule_type")
}

enum TimeRecordType {
  ENTRY
  BREAK_START
  BREAK_END
  EXIT
  EXTRA
  UNCLASSIFIED

  @@map("time_record_type")
}

enum TimeRecordSource {
  WEB
  MOBILE
  KIOSK
  DEVICE
  COMMUNICATION_SERVER
  IMPORT
  MANUAL_ADJUSTMENT

  @@map("time_record_source")
}

enum AdjustmentKind {
  INCLUDE
  DISREGARD
  RECLASSIFY

  @@map("adjustment_kind")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
  CANCELLED

  @@map("approval_status")
}

enum RequestType {
  RECORD_CORRECTION
  ABSENCE_JUSTIFICATION
  SCHEDULE_ADJUSTMENT
  COMPENSATION
  ALLOWANCE
  SCHEDULE_CHANGE
  OTHER

  @@map("request_type")
}

enum OccurrenceType {
  ABSENCE
  LATE
  EARLY_LEAVE
  MISSING_RECORD
  OVERTIME
  INSUFFICIENT_BREAK
  UNCOVERED_SHIFT
  SHIFT_NOT_STARTED
  SHIFT_NOT_CLOSED
  SCHEDULE_CONFLICT
  INCOMPLETE_TEAM
  OPERATIONAL_ISSUE
  PROFESSIONAL_SWAP
  SCHEDULE_CHANGE
  EQUIPMENT_UNAVAILABLE
  OTHER

  @@map("occurrence_type")
}

enum OccurrenceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED

  @@map("occurrence_status")
}

enum BankHourTransactionType {
  CREDIT
  DEBIT
  COMPENSATION
  ADJUSTMENT
  PAYOUT
  EXPIRATION

  @@map("bank_hour_transaction_type")
}

enum ClosingStatus {
  OPEN
  CLOSED
  REOPENED

  @@map("closing_status")
}

enum ShiftKind {
  DAY
  NIGHT
  H12
  H24
  ON_CALL
  EXTRA
  COVERAGE

  @@map("shift_kind")
}

enum ShiftAssignmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  ABSENT
  SUBSTITUTED
  CANCELLED

  @@map("shift_assignment_status")
}

enum ClassSessionStatus {
  SCHEDULED
  HELD
  NOT_HELD
  SUBSTITUTED
  CANCELLED

  @@map("class_session_status")
}

enum CalendarEventType {
  HOLIDAY
  RECESS
  SCHOOL_VACATION
  ACADEMIC_TERM
  MEETING
  PLANNING_DAY
  EVENT
  OPTIONAL_DAY

  @@map("calendar_event_type")
}

enum DeviceCategory {
  TIME_CLOCK
  BIOMETRIC_READER
  FINGERPRINT_READER
  FACIAL_RECOGNITION
  RFID_READER
  CARD_READER
  ACCESS_CONTROLLER
  TURNSTILE
  GATE
  ELECTRONIC_LOCK
  DOOR_CONTROLLER
  IDENTIFICATION_TERMINAL

  @@map("device_category")
}

enum DeviceStatus {
  PENDING
  ONLINE
  OFFLINE
  ERROR
  DISABLED

  @@map("device_status")
}

enum HomologationStatus {
  NOT_TESTED
  IN_TESTING
  HOMOLOGATED
  PARTIAL
  REJECTED

  @@map("homologation_status")
}

enum DeviceIdentifierType {
  REGISTRATION
  CARD
  RFID
  PIN
  BIOMETRIC_REFERENCE
  FACIAL_REFERENCE

  @@map("device_identifier_type")
}

enum DeviceEventKind {
  TIME_RECORD
  ACCESS_GRANTED
  ACCESS_DENIED
  DOOR_OPENED
  TURNSTILE_PASS
  STATUS
  ALARM
  OTHER

  @@map("device_event_kind")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("job_status")
}

enum ServerStatus {
  PENDING
  ONLINE
  DEGRADED
  OFFLINE
  DISABLED

  @@map("server_status")
}

enum PermissionScope {
  PLATFORM
  TENANT
  COMPANY
  UNIT
  DEPARTMENT
  SELF

  @@map("permission_scope")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH

  @@map("notification_channel")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@map("subscription_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  CLOSE_PERIOD
  REOPEN_PERIOD
  PERMISSION_CHANGE
  OTHER

  @@map("audit_action")
}

// -----------------------------------------------------------------------------
// Estrutura organizacional
// -----------------------------------------------------------------------------

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  slug          String       @unique
  status        TenantStatus @default(TRIAL)
  document      String?
  contactEmail  String? @map("contact_email")
  contactPhone  String? @map("contact_phone")
  settings      Json         @default("{}")
  createdAt     DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt     DateTime?    @db.Timestamptz(6) @map("deleted_at")

  companies      Company[]
  users          User[]
  roles          Role[]
  people         Person[]
  subscriptions  Subscription[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  commServers    CommunicationServer[]

  @@map("tenants")
}

model Company {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid @map("tenant_id")
  legalName     String @map("legal_name")
  tradeName     String? @map("trade_name")
  cnpj          String?
  segment       CompanySegment @default(GENERAL)
  timezone      String         @default("America/Sao_Paulo")
  settings      Json           @default("{}")
  createdAt     DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt     DateTime?      @db.Timestamptz(6) @map("deleted_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  units         CompanyUnit[]
  departments   Department[]
  positions     JobPosition[]
  employments   Employment[]
  schedules     WorkSchedule[]
  ruleSets      AttendanceRuleSet[]
  calendars     Calendar[]
  devices       Device[]
  closings      TimeClosing[]
  approvalFlows ApprovalFlow[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])

  @@map("companies")
}

model CompanyUnit {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  companyId  String    @db.Uuid @map("company_id")
  parentId   String?   @db.Uuid @map("parent_id")
  name       String
  code       String?
  type       UnitType  @default(OFFICE)
  cnpj       String?
  address    Json?
  latitude   Decimal?  @db.Decimal(10, 7)
  longitude  Decimal?  @db.Decimal(10, 7)
  geofenceM  Int? @map("geofence_m")
  timezone   String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt  DateTime? @db.Timestamptz(6) @map("deleted_at")

  company     Company        @relation(fields: [companyId], references: [id])
  parent      CompanyUnit?   @relation("UnitTree", fields: [parentId], references: [id])
  children    CompanyUnit[]  @relation("UnitTree")
  departments Department[]
  employments Employment[]
  devices     Device[]
  classrooms  Classroom[]
  rooms       ConsultationRoom[]
  shifts      MedicalShift[]
  teams       OperationalTeam[]

  @@unique([companyId, code])
  @@index([tenantId, companyId])

  @@map("company_units")
}

model Department {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  companyId  String    @db.Uuid @map("company_id")
  unitId     String?   @db.Uuid @map("unit_id")
  parentId   String?   @db.Uuid @map("parent_id")
  name       String
  code       String?
  managerEmploymentId String? @db.Uuid @map("manager_employment_id")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt  DateTime? @db.Timestamptz(6) @map("deleted_at")

  company     Company       @relation(fields: [companyId], references: [id])
  unit        CompanyUnit?  @relation(fields: [unitId], references: [id])
  parent      Department?   @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[]  @relation("DepartmentTree")
  sectors     Sector[]
  employments Employment[]

  @@unique([companyId, code])
  @@index([tenantId, companyId])

  @@map("departments")
}

model Sector {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid @map("tenant_id")
  departmentId String    @db.Uuid @map("department_id")
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt    DateTime? @db.Timestamptz(6) @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id])

  @@index([tenantId, departmentId])

  @@map("sectors")
}

model OperationalTeam {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid @map("tenant_id")
  unitId      String    @db.Uuid @map("unit_id")
  name        String
  minMembers  Int       @default(1) @map("min_members")
  supervisorEmploymentId String? @db.Uuid @map("supervisor_employment_id")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  unit        CompanyUnit             @relation(fields: [unitId], references: [id])
  assignments OperationalAssignment[]

  @@index([tenantId, unitId])

  @@map("operational_teams")
}

// -----------------------------------------------------------------------------
// Pessoas e vínculos
// -----------------------------------------------------------------------------

model Person {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid @map("tenant_id")
  fullName    String @map("full_name")
  socialName  String? @map("social_name")
  email       String?
  phone       String?
  // Dados pessoais sensíveis: acesso restrito por permissão; nunca chave primária.
  cpf         String?
  pis         String?
  birthDate   DateTime?    @db.Date @map("birth_date")
  address     Json?
  photoPath   String? @map("photo_path")
  status      PersonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime?    @db.Timestamptz(6) @map("deleted_at")

  tenant        Tenant                   @relation(fields: [tenantId], references: [id])
  employments   Employment[]
  documents     PersonDocument[]
  registrations ProfessionalRegistration[]
  user          User?

  @@unique([tenantId, cpf])
  @@index([tenantId, fullName])

  @@map("people")
}

model PersonDocument {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  personId   String    @db.Uuid @map("person_id")
  kind       String
  number     String?
  filePath   String? @map("file_path")
  issuedAt   DateTime? @db.Date @map("issued_at")
  expiresAt  DateTime? @db.Date @map("expires_at")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt  DateTime? @db.Timestamptz(6) @map("deleted_at")

  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])

  @@map("person_documents")
}

/// Registro em conselho profissional (CRM, COREN, CRP, CRF, CRO...).
model ProfessionalRegistration {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  personId   String    @db.Uuid @map("person_id")
  council    String
  number     String
  state      String
  rqe        String?
  validUntil DateTime? @db.Date @map("valid_until")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt  DateTime? @db.Timestamptz(6) @map("deleted_at")

  person Person @relation(fields: [personId], references: [id])

  @@unique([tenantId, council, state, number])
  @@index([tenantId, personId])

  @@map("professional_registrations")
}

model JobPosition {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @db.Uuid @map("tenant_id")
  companyId  String               @db.Uuid @map("company_id")
  name       String
  category   ProfessionalCategory @default(GENERAL)
  cbo        String?
  createdAt  DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt  DateTime?            @db.Timestamptz(6) @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id])
  employments Employment[]

  @@unique([companyId, name])
  @@index([tenantId])

  @@map("job_positions")
}

model Specialty {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid @map("tenant_id")
  name      String
  category  ProfessionalCategory @default(PHYSICIAN)
  parentId  String?              @db.Uuid @map("parent_id")
  createdAt DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")

  parent      Specialty?            @relation("SpecialtyTree", fields: [parentId], references: [id])
  children    Specialty[]           @relation("SpecialtyTree")
  employments EmploymentSpecialty[]
  shifts      MedicalShift[]

  @@unique([tenantId, name])

  @@map("professional_specialties")
}

/// Vínculo funcional: uma pessoa pode ter vários (escolas, hospitais, contratos).
/// A matrícula é o identificador operacional, única dentro da empresa.
model Employment {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid @map("tenant_id")
  personId           String               @db.Uuid @map("person_id")
  companyId          String               @db.Uuid @map("company_id")
  unitId             String?              @db.Uuid @map("unit_id")
  departmentId       String?              @db.Uuid @map("department_id")
  positionId         String?              @db.Uuid @map("position_id")
  registration       String
  category           ProfessionalCategory @default(GENERAL)
  contractType       ContractType         @default(CLT) @map("contract_type")
  function           String?
  status             EmploymentStatus     @default(ACTIVE)
  hiredAt            DateTime             @db.Date @map("hired_at")
  terminatedAt       DateTime?            @db.Date @map("terminated_at")
  weeklyHours        Decimal?             @db.Decimal(5, 2) @map("weekly_hours")
  supervisorId       String?              @db.Uuid @map("supervisor_id")
  ruleSetId          String?              @db.Uuid @map("rule_set_id")
  createdAt          DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt          DateTime?            @db.Timestamptz(6) @map("deleted_at")

  person       Person              @relation(fields: [personId], references: [id])
  company      Company             @relation(fields: [companyId], references: [id])
  unit         CompanyUnit?        @relation(fields: [unitId], references: [id])
  department   Department?         @relation(fields: [departmentId], references: [id])
  position     JobPosition?        @relation(fields: [positionId], references: [id])
  supervisor   Employment?         @relation("Supervision", fields: [supervisorId], references: [id])
  supervised   Employment[]        @relation("Supervision")
  ruleSet      AttendanceRuleSet?  @relation(fields: [ruleSetId], references: [id])

  history             EmploymentHistory[]
  specialties         EmploymentSpecialty[]
  scheduleAssignments ScheduleAssignment[]
  timeRecords         TimeRecord[]
  calculations        TimeCalculation[]
  bankAccount         BankHourAccount?
  occurrences         AttendanceOccurrence[]
  requests            TimeRequest[]
  deviceIdentifiers   DeviceIdentifier[]
  teachingAssignments TeachingAssignment[]
  shiftAssignments    MedicalShiftAssignment[]
  availability        ProfessionalAvailability[]
  operationalAssignments OperationalAssignment[]
  accessEvents        AccessEvent[]

  @@unique([companyId, registration])
  @@index([tenantId, personId])
  @@index([tenantId, companyId, status])
  @@index([tenantId, unitId])

  @@map("employment_relationships")
}

/// Histórico funcional: cada alteração relevante do vínculo (cargo, unidade, jornada, situação).
model EmploymentHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  employmentId String   @db.Uuid @map("employment_id")
  field        String
  oldValue     Json? @map("old_value")
  newValue     Json? @map("new_value")
  effectiveAt  DateTime @db.Date @map("effective_at")
  reason       String?
  actorUserId  String?  @db.Uuid @map("actor_user_id")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, effectiveAt])

  @@map("employment_history")
}

model EmploymentSpecialty {
  employmentId String @db.Uuid @map("employment_id")
  specialtyId  String @db.Uuid @map("specialty_id")
  tenantId     String @db.Uuid @map("tenant_id")

  employment Employment @relation(fields: [employmentId], references: [id])
  specialty  Specialty  @relation(fields: [specialtyId], references: [id])

  @@id([employmentId, specialtyId])

  @@map("employment_specialties")
}

// -----------------------------------------------------------------------------
// Jornadas, escalas e calendário
// -----------------------------------------------------------------------------

/// Regras de apuração (tolerâncias, extras, noturno, banco de horas) por empresa/vínculo.
model AttendanceRuleSet {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  companyId  String    @db.Uuid @map("company_id")
  name       String
  isDefault  Boolean   @default(false) @map("is_default")
  rules      Json
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt  DateTime? @db.Timestamptz(6) @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id])
  employments Employment[]
  schedules   WorkSchedule[]

  @@index([tenantId, companyId])

  @@map("attendance_rule_sets")
}

/// Jornada/escala modelo. Para escalas cíclicas (12x36, 6x1, rotativas), `cycle` define a sequência.
model WorkSchedule {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid @map("tenant_id")
  companyId     String       @db.Uuid @map("company_id")
  name          String
  type          ScheduleType
  weeklyMinutes Int? @map("weekly_minutes")
  cycleDays     Int? @map("cycle_days")
  cycle         Json?
  ruleSetId     String?      @db.Uuid @map("rule_set_id")
  createdAt     DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt     DateTime?    @db.Timestamptz(6) @map("deleted_at")

  company     Company              @relation(fields: [companyId], references: [id])
  ruleSet     AttendanceRuleSet?   @relation(fields: [ruleSetId], references: [id])
  days        WorkScheduleDay[]
  assignments ScheduleAssignment[]

  @@unique([companyId, name])
  @@index([tenantId])

  @@map("work_schedules")
}

/// Dia de uma jornada: dia da semana (0-6) para jornadas semanais ou posição no ciclo.
model WorkScheduleDay {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid @map("tenant_id")
  scheduleId   String  @db.Uuid @map("schedule_id")
  dayIndex     Int @map("day_index")
  isWorkday    Boolean @default(true) @map("is_workday")
  startTime    String? @map("start_time")
  endTime      String? @map("end_time")
  breakMinutes Int     @default(0) @map("break_minutes")
  breakStart   String? @map("break_start")
  expectedMinutes Int  @default(0) @map("expected_minutes")

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayIndex])

  @@map("work_schedule_days")
}

/// Atribuição de jornada a um vínculo, com vigência (histórico preservado).
model ScheduleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid @map("tenant_id")
  employmentId String    @db.Uuid @map("employment_id")
  scheduleId   String    @db.Uuid @map("schedule_id")
  validFrom    DateTime  @db.Date @map("valid_from")
  validTo      DateTime? @db.Date @map("valid_to")
  cycleStart   DateTime? @db.Date @map("cycle_start")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  employment Employment   @relation(fields: [employmentId], references: [id])
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id])

  @@index([tenantId, employmentId, validFrom])

  @@map("schedule_assignments")
}

model Calendar {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  companyId  String    @db.Uuid @map("company_id")

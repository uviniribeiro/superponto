  manufacturerId String         @db.Uuid @map("manufacturer_id")
  name           String
  category       DeviceCategory
  protocols      String[]
  capabilities   Json           @default("{}")

  manufacturer  DeviceManufacturer   @relation(fields: [manufacturerId], references: [id])
  adapters      DeviceAdapter[]
  homologations DeviceHomologation[]
  devices       Device[]

  @@unique([manufacturerId, name])

  @@map("device_models")
}

model DeviceAdapter {
  id        String  @id @default(uuid()) @db.Uuid
  modelId   String  @db.Uuid @map("model_id")
  key       String
  version   String
  transport String

  model DeviceModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, key, version])

  @@map("device_adapters")
}

/// Matriz de compatibilidade: só "HOMOLOGATED" após teste com equipamento real.
model DeviceHomologation {
  id             String             @id @default(uuid()) @db.Uuid
  modelId        String             @db.Uuid @map("model_id")
  firmware       String
  adapterKey     String @map("adapter_key")
  adapterVersion String @map("adapter_version")
  connection     String
  features       Json               @default("{}")
  status         HomologationStatus @default(NOT_TESTED)
  testedAt       DateTime?          @db.Timestamptz(6) @map("tested_at")
  limitations    String?

  model DeviceModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, firmware, adapterKey, adapterVersion])

  @@map("device_homologations")
}

model Device {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid @map("tenant_id")
  companyId        String         @db.Uuid @map("company_id")
  unitId           String?        @db.Uuid @map("unit_id")
  modelId          String?        @db.Uuid @map("model_id")
  commServerId     String?        @db.Uuid @map("comm_server_id")
  name             String
  serialNumber     String? @map("serial_number")
  firmware         String?
  host             String?
  port             Int?
  protocol         String?
  internalCode     String? @map("internal_code")
  usage            String[]       @default(["TIME"])
  status           DeviceStatus   @default(PENDING)
  lastSeenAt       DateTime?      @db.Timestamptz(6) @map("last_seen_at")
  lastSyncAt       DateTime?      @db.Timestamptz(6) @map("last_sync_at")
  adapterVersion   String? @map("adapter_version")
  // Credenciais do equipamento ficam cifradas (nunca retornam ao frontend).
  credentialsEnc   String? @map("credentials_enc")
  createdAt        DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt        DateTime?      @db.Timestamptz(6) @map("deleted_at")

  company     Company              @relation(fields: [companyId], references: [id])
  unit        CompanyUnit?         @relation(fields: [unitId], references: [id])
  model       DeviceModel?         @relation(fields: [modelId], references: [id])
  commServer  CommunicationServer? @relation(fields: [commServerId], references: [id])
  identifiers DeviceIdentifier[]
  events      DeviceEvent[]
  logs        DeviceLog[]
  syncJobs    DeviceSyncJob[]
  timeRecords TimeRecord[]
  accessEvents AccessEvent[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId, companyId, status])
  @@index([commServerId])

  @@map("devices")
}

/// Identificador do vínculo no equipamento (matrícula, cartão, RFID, referência biométrica).
/// Templates biométricos não são armazenados aqui: apenas a referência no equipamento.
model DeviceIdentifier {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid @map("tenant_id")
  employmentId String               @db.Uuid @map("employment_id")
  deviceId     String?              @db.Uuid @map("device_id")
  type         DeviceIdentifierType
  value        String
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")

  employment Employment @relation(fields: [employmentId], references: [id])
  device     Device?    @relation(fields: [deviceId], references: [id])

  @@unique([tenantId, type, value, deviceId])
  @@index([tenantId, employmentId])

  @@map("device_identifiers")
}

/// Evento bruto recebido do equipamento (ponto, acesso, status). Ponto ≠ acesso físico.
model DeviceEvent {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid @map("tenant_id")
  deviceId    String          @db.Uuid @map("device_id")
  kind        DeviceEventKind
  occurredAt  DateTime        @db.Timestamptz(6) @map("occurred_at")
  identifier  String?
  nsr         BigInt?
  payload     Json
  processedAt DateTime?       @db.Timestamptz(6) @map("processed_at")
  commEventId String?         @db.Uuid @map("comm_event_id")
  createdAt   DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, kind, nsr, occurredAt])
  @@index([tenantId, deviceId, occurredAt])

  @@map("device_events")
}

model DeviceLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  deviceId  String   @db.Uuid @map("device_id")
  level     String
  message   String
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId, deviceId, createdAt])

  @@map("device_logs")
}

/// Comando/sincronização para o equipamento (enviado via Communication Server).
model DeviceSyncJob {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid @map("tenant_id")
  deviceId    String    @db.Uuid @map("device_id")
  action      String
  payload     Json      @default("{}")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lastError   String? @map("last_error")
  scheduledAt DateTime  @default(now()) @db.Timestamptz(6) @map("scheduled_at")
  finishedAt  DateTime? @db.Timestamptz(6) @map("finished_at")
  createdById String?   @db.Uuid @map("created_by_id")

  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId, deviceId, status])

  @@map("device_sync_jobs")
}

/// Evento de acesso físico (porta, catraca). Separado de TimeRecord por finalidade.
model AccessEvent {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid @map("tenant_id")
  deviceId     String          @db.Uuid @map("device_id")
  employmentId String?         @db.Uuid @map("employment_id")
  kind         DeviceEventKind
  occurredAt   DateTime        @db.Timestamptz(6) @map("occurred_at")
  granted      Boolean
  direction    String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")

  device     Device      @relation(fields: [deviceId], references: [id])
  employment Employment? @relation(fields: [employmentId], references: [id])

  @@index([tenantId, deviceId, occurredAt])

  @@map("access_events")
}

// -----------------------------------------------------------------------------
// Communication Server
// -----------------------------------------------------------------------------

model CommunicationServer {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String?      @db.Uuid @map("tenant_id")
  name          String
  identifier    String       @unique
  publicIp      String? @map("public_ip")
  domain        String?
  port          Int?
  protocol      String       @default("https")
  status        ServerStatus @default(PENDING)
  version       String?
  lastSeenAt    DateTime?    @db.Timestamptz(6) @map("last_seen_at")
  allowedCompanyIds String[] @db.Uuid @map("allowed_company_ids")
  allowedUnitIds    String[] @db.Uuid @map("allowed_unit_ids")
  createdAt     DateTime     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt     DateTime?    @db.Timestamptz(6) @map("deleted_at")

  tenant      Tenant?                         @relation(fields: [tenantId], references: [id])
  credentials CommunicationServerCredential[]
  devices     Device[]
  events      CommunicationEvent[]
  history     CommunicationSyncHistory[]
  logs        CommunicationLog[]

  @@map("communication_servers")
}

/// Credencial do servidor: só o hash do segredo; rotação com validade.
model CommunicationServerCredential {
  id          String    @id @default(uuid()) @db.Uuid
  serverId    String    @db.Uuid @map("server_id")
  keyId       String    @unique @map("key_id")
  secretHash  String @map("secret_hash")
  certFingerprint String? @map("cert_fingerprint")
  expiresAt   DateTime? @db.Timestamptz(6) @map("expires_at")
  revokedAt   DateTime? @db.Timestamptz(6) @map("revoked_at")
  lastUsedAt  DateTime? @db.Timestamptz(6) @map("last_used_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@map("communication_server_credentials")
}

/// Lote recebido do Communication Server; idempotente por (serverId, batchId).
model CommunicationEvent {
  id          String    @id @default(uuid()) @db.Uuid
  serverId    String    @db.Uuid @map("server_id")
  tenantId    String?   @db.Uuid @map("tenant_id")
  batchId     String @map("batch_id")
  kind        String
  itemCount   Int @map("item_count")
  acceptedCount Int     @default(0) @map("accepted_count")
  duplicateCount Int    @default(0) @map("duplicate_count")
  rejectedCount Int     @default(0) @map("rejected_count")
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6) @map("received_at")
  processedAt DateTime? @db.Timestamptz(6) @map("processed_at")
  errors      Json      @default("[]")

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@unique([serverId, batchId])
  @@index([serverId, receivedAt])

  @@map("communication_events")
}

model CommunicationSyncHistory {
  id          String   @id @default(uuid()) @db.Uuid
  serverId    String   @db.Uuid @map("server_id")
  direction   String
  summary     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])

  @@map("communication_sync_history")
}

model CommunicationLog {
  id        String   @id @default(uuid()) @db.Uuid
  serverId  String   @db.Uuid @map("server_id")
  level     String
  message   String
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  server CommunicationServer @relation(fields: [serverId], references: [id])

  @@index([serverId, createdAt])

  @@map("communication_logs")
}

// -----------------------------------------------------------------------------
// Usuários, perfis, permissões e auditoria
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @db.Uuid @map("tenant_id")
  personId       String?   @unique @db.Uuid @map("person_id")
  email          String    @unique
  passwordHash   String? @map("password_hash")
  displayName    String @map("display_name")
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  isActive       Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt    DateTime? @db.Timestamptz(6) @map("last_login_at")
  failedLogins   Int       @default(0) @map("failed_logins")
  lockedUntil    DateTime? @db.Timestamptz(6) @map("locked_until")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt      DateTime? @db.Timestamptz(6) @map("deleted_at")

  tenant        Tenant?                  @relation(fields: [tenantId], references: [id])
  person        Person?                  @relation(fields: [personId], references: [id])
  roles         UserRole[]
  notifications Notification[]
  preferences   NotificationPreference[]

  @@map("users")
}




// -----------------------------------------------------------------------------
// Estado de autenticação (@nestjs/authentication). Tokens, sessões e links são
// guardados como SHA-256; segredos TOTP chegam cifrados (AES-256-GCM).
// -----------------------------------------------------------------------------

model AuthSession {
  id           String    @id
  userId       String @map("user_id")
  createdAt    DateTime  @db.Timestamptz(6) @map("created_at")
  expiresAt    DateTime  @db.Timestamptz(6) @map("expires_at")
  lastActiveAt DateTime  @db.Timestamptz(6) @map("last_active_at")
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id              String    @id
  familyId        String @map("family_id")
  userId          String @map("user_id")
  createdAt       DateTime  @db.Timestamptz(6) @map("created_at")
  expiresAt       DateTime  @db.Timestamptz(6) @map("expires_at")
  familyExpiresAt DateTime  @db.Timestamptz(6) @map("family_expires_at")
  usedAt          DateTime? @db.Timestamptz(6) @map("used_at")
  claims          Json?
  revoked         Boolean   @default(false)

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
  @@map("auth_refresh_tokens")
}

model MfaAuthenticator {
  userId        String  @id @map("user_id")
  secret        String
  confirmed     Boolean
  pendingSecret String? @map("pending_secret")
  lastUsedStep  Int? @map("last_used_step")

  @@map("auth_mfa_authenticators")
}

model MfaRecoveryCode {
  userId   String @map("user_id")
  codeHash String @map("code_hash")

  @@id([userId, codeHash])
  @@map("auth_mfa_recovery_codes")
}

model MfaFailure {
  id       Int      @id @default(autoincrement())
  userId   String @map("user_id")
  failedAt DateTime @db.Timestamptz(6) @map("failed_at")

  @@index([userId, failedAt])
  @@index([failedAt])
  @@map("auth_mfa_failures")
}

model EmailToken {
  id          String   @id
  purpose     String
  userId      String @map("user_id")
  email       String
  fingerprint String?
  createdAt   DateTime @db.Timestamptz(6) @map("created_at")
  expiresAt   DateTime @db.Timestamptz(6) @map("expires_at")

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_email_tokens")
}

/// Perfil: tenantId nulo = perfil de sistema (modelo), copiado/usado por todos.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid @map("tenant_id")
  key         String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])

  @@map("roles")
}

/// Permissão global no formato "modulo.recurso:acao" (ex.: "time.records:approve").
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid @map("role_id")
  permissionId String @db.Uuid @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])

  @@map("role_permissions")
}

/// Papel do usuário com escopo (tenant inteiro, empresa, unidade ou departamento).
model UserRole {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid @map("user_id")
  roleId       String          @db.Uuid @map("role_id")
  tenantId     String?         @db.Uuid @map("tenant_id")
  scope        PermissionScope @default(TENANT)
  companyId    String?         @db.Uuid @map("company_id")
  unitId       String?         @db.Uuid @map("unit_id")
  departmentId String?         @db.Uuid @map("department_id")
  createdAt    DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope, companyId, unitId, departmentId])
  @@index([tenantId, userId])

  @@map("user_roles")
}

/// Trilha de auditoria (somente inserção; gatilho bloqueia alteração e exclusão).
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @db.Uuid @map("tenant_id")
  actorUserId String?    @db.Uuid @map("actor_user_id")
  action     AuditAction
  entity     String
  entityId   String? @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String? @map("user_agent")
  requestId  String? @map("request_id")
  createdAt  DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])

  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Notificações
// -----------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid @map("tenant_id")
  userId    String              @db.Uuid @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?           @db.Timestamptz(6) @map("read_at")
  sentAt    DateTime?           @db.Timestamptz(6) @map("sent_at")
  createdAt DateTime            @default(now()) @db.Timestamptz(6) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])

  @@map("notifications")
}

model NotificationPreference {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @db.Uuid @map("user_id")
  type     String
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])

  @@map("notification_preferences")
}

// -----------------------------------------------------------------------------
// SaaS: planos, assinaturas e cobrança
// -----------------------------------------------------------------------------

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  priceCents  Int @map("price_cents")
  currency    String   @default("BRL")
  interval    String   @default("month")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Limite ou módulo do plano (ex.: "limit.employments" = 100, "module.health" = true).
model PlanFeature {
  id      String @id @default(uuid()) @db.Uuid
  planId  String @db.Uuid @map("plan_id")
  key     String
  value   Json

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])

  @@map("plan_features")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid @map("tenant_id")
  planId             String             @db.Uuid @map("plan_id")
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?          @db.Timestamptz(6) @map("trial_ends_at")
  currentPeriodStart DateTime           @db.Timestamptz(6) @map("current_period_start")
  currentPeriodEnd   DateTime           @db.Timestamptz(6) @map("current_period_end")
  cancelAt           DateTime?          @db.Timestamptz(6) @map("cancel_at")
  addons             Json               @default("[]")
  overrides          Json               @default("{}")
  externalId         String? @map("external_id")
  createdAt          DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  plan   Plan           @relation(fields: [planId], references: [id])
  events BillingEvent[]

  @@index([tenantId, status])

  @@map("subscriptions")
}

model BillingEvent {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String?  @db.Uuid @map("subscription_id")
  tenantId       String?  @db.Uuid @map("tenant_id")
  provider       String
  externalId     String @map("external_id")
  type           String
  amountCents    Int? @map("amount_cents")
  payload        Json
  processedAt    DateTime? @db.Timestamptz(6) @map("processed_at")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([provider, externalId])

  @@map("billing_events")
}

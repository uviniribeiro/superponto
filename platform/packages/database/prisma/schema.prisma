  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  employments Employment[]

  @@index([tenantId])
  @@map("job_functions")
}

model CostCenter {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String?
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  employments Employment[]

  @@index([tenantId])
  @@map("cost_centers")
}

/// Classificação configurável pelo cliente (efetivo, comissionado, estagiário, terceirizado…).
model EmployeeType {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String?
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  employments Employment[]

  @@index([tenantId])
  @@map("employee_types")
}

enum UnionEntityType {
  SINDICATO
  FEDERACAO
  CONFEDERACAO
  CENTRAL

  @@map("union_entity_type")
}

enum UnionSide {
  EMPREGADOS
  EMPREGADORES

  @@map("union_side")
}

model LaborUnion {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  code       String?
  name       String
  acronym    String
  cnpj       String?
  entityType UnionEntityType @default(SINDICATO) @map("entity_type")
  side       UnionSide       @default(EMPREGADOS)
  /// mês da data-base da categoria (1-12)
  baseMonth  Int?            @map("base_month") @db.SmallInt
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(6)

  employments Employment[]

  @@index([tenantId])
  @@map("labor_unions")
}

/// Período nomeado usado como filtro em todo o sistema (ex.: "Janeiro/2027", "1º trimestre").
model Competence {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime  @map("ends_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, startsOn])
  @@map("competences")
}

/// Logo da empresa (PNG, JPEG ou WebP até 512 KB), separado para não pesar nas listagens.
model CompanyLogo {
  companyId String   @id @map("company_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([tenantId])
  @@map("company_logos")
}

// -----------------------------------------------------------------------------
// Agrupamentos e controle de acesso
// -----------------------------------------------------------------------------

/// Agrupamento livre de funcionários, cargos e unidades (locais de trabalho), usado como filtro
/// em relatórios, cálculo em lote e envio aos relógios.
model Grouping {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String?
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  employments GroupingEmployment[]
  positions   GroupingPosition[]
  units       GroupingUnit[]

  @@index([tenantId])
  @@map("groupings")
}

model GroupingEmployment {
  groupingId   String @map("grouping_id") @db.Uuid
  employmentId String @map("employment_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  grouping   Grouping   @relation(fields: [groupingId], references: [id], onDelete: Cascade)
  employment Employment @relation(fields: [employmentId], references: [id])

  @@id([groupingId, employmentId])
  @@index([tenantId, employmentId])
  @@map("grouping_employments")
}

model GroupingPosition {
  groupingId String @map("grouping_id") @db.Uuid
  positionId String @map("position_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid

  grouping Grouping    @relation(fields: [groupingId], references: [id], onDelete: Cascade)
  position JobPosition @relation(fields: [positionId], references: [id])

  @@id([groupingId, positionId])
  @@map("grouping_positions")
}

model GroupingUnit {
  groupingId String @map("grouping_id") @db.Uuid
  unitId     String @map("unit_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid

  grouping Grouping    @relation(fields: [groupingId], references: [id], onDelete: Cascade)
  unit     CompanyUnit @relation(fields: [unitId], references: [id])

  @@id([groupingId, unitId])
  @@map("grouping_units")
}

/// Bloqueio de acesso de um usuário por período, com motivo (ex.: férias, afastamento, investigação).
model UserAccessBlock {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  reason      String
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  /// vazio = por tempo indeterminado
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  createdById String?   @map("created_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("BlockedUser", fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@map("user_access_blocks")
}

enum AuthSource {
  LOCAL
  LDAP

  @@map("auth_source")
}

/// Login pelo diretório do cliente (Active Directory / OpenLDAP). A senha da conta de serviço é
/// guardada cifrada (AES-256-GCM) e nunca volta pela API.
model TenantLdapConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  enabled          Boolean  @default(false)
  url              String
  startTls         Boolean  @default(false) @map("start_tls")
  /// aceita certificado não confiável (somente para servidores internos com certificado próprio)
  allowInsecureTls Boolean  @default(false) @map("allow_insecure_tls")
  bindDn           String?  @map("bind_dn")
  bindPasswordEnc  String?  @map("bind_password_enc")
  baseDn           String   @map("base_dn")
  /// filtro de busca; {email} e {login} (parte antes do @) são substituídos com escape
  userFilter       String   @default("(mail={email})") @map("user_filter")
  timeoutMs        Int      @default(5000) @map("timeout_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_ldap_configs")
}

/// Escala agendada: trabalho ou folga definidos para um dia específico de um vínculo
/// (vence a jornada atribuída e o feriado). Também registra trocas de escala e de folga.
model ScheduleOverride {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  date         DateTime @db.Date
  isWorkday    Boolean  @map("is_workday")
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")
  breakMinutes Int      @default(0) @map("break_minutes")
  breakStart   String?  @map("break_start")
  /// AGENDADA (lançamento direto) ou TROCA (troca de escala/folga)
  origin       String   @default("AGENDADA")
  note         String?
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employment Employment @relation(fields: [employmentId], references: [id])

  @@unique([employmentId, date])
  @@index([tenantId, date])
  @@map("schedule_overrides")
}

/// Justificativa (código de abono/ocorrência). "Abona" = o dia/minutos não geram débito.
model Justification {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  code             String?
  name             String
  /// abona: falta ou atraso justificado não gera débito; sem abonar, só fica justificado (e descontado)
  disregardsDebits Boolean   @default(true) @map("disregards_debits")
  /// limite de uso por funcionário no período (null = sem limite)
  usageLimit       Int?      @map("usage_limit")
  /// MONTH ou YEAR
  limitPeriod      String    @default("MONTH") @map("limit_period")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  allowances Allowance[]
  leaves     Leave[]

  @@index([tenantId])
  @@map("justifications")
}

/// Abono: falta (dia inteiro) ou minutos justificados num dia.
model Allowance {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  employmentId    String   @map("employment_id") @db.Uuid
  date            DateTime @db.Date
  justificationId String   @map("justification_id") @db.Uuid
  fullDay         Boolean  @default(true) @map("full_day")
  minutes         Int      @default(0)
  note            String?
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employment    Employment    @relation(fields: [employmentId], references: [id])
  justification Justification @relation(fields: [justificationId], references: [id])

  @@unique([employmentId, date])
  @@index([tenantId, date])
  @@map("allowances")
}

enum LeaveType {
  MEDICAL
  VACATION
  MATERNITY
  PATERNITY
  WORK_ACCIDENT
  UNPAID
  SUSPENSION
  OTHER

  @@map("leave_type")
}

/// Afastamento (atestado, férias, licenças): dias neutros na apuração.
model Leave {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employmentId    String    @map("employment_id") @db.Uuid
  type            LeaveType
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  justificationId String?   @map("justification_id") @db.Uuid
  note            String?
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  employment    Employment     @relation(fields: [employmentId], references: [id])
  justification Justification? @relation(fields: [justificationId], references: [id])

  @@index([tenantId, employmentId, startDate])
  @@map("leaves")
}

/// Sobreaviso (CLT art. 244 §2º): horas à disposição fora do local, pagas à razão de 1/3.
model OnCallPeriod {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  date         DateTime @db.Date
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  minutes      Int
  note         String?
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, date])
  @@map("on_call_periods")
}

/// Regras do banco de horas da empresa (créditos e débitos lançados no fechamento do período).
model BankPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  companyId             String   @unique @map("company_id") @db.Uuid
  enabled               Boolean  @default(false)
  /// dias até o crédito vencer (null = não vence); acordo individual: até 6 meses (CLT art. 59 §5º)
  expirationDays        Int?     @map("expiration_days")
  maxDailyCreditMinutes Int?     @map("max_daily_credit_minutes")
  /// multiplicador do crédito por percentual de extra, ex.: {"50": 1.5}
  creditMultipliers     Json     @default("{}") @map("credit_multipliers")
  /// banco de compensação: os saldos diários se compensam dentro da semana ou do mês antes do banco
  compensationEnabled   Boolean  @default(false) @map("compensation_enabled")
  /// WEEK ou MONTH
  compensationPeriod    String   @default("WEEK") @map("compensation_period")
  /// sobra positiva da compensação: BANK (vai para o banco) ou PAY (paga como extra)
  compensationLeftover  String   @default("BANK") @map("compensation_leftover")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@map("bank_policies")
}

/// Autorização prévia de hora extra (política de hora extra).
model OvertimeAuthorization {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  date         DateTime @db.Date
  maxMinutes   Int      @map("max_minutes")
  requestId    String?  @map("request_id") @db.Uuid
  note         String?
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employment Employment @relation(fields: [employmentId], references: [id])

  @@unique([employmentId, date])
  @@map("overtime_authorizations")
}

/// Funcionários lidos do equipamento (comando "receber funcionários"), para comparar com o cadastro.
model DeviceRosterEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  deviceId     String   @map("device_id") @db.Uuid
  /// PIS (Portaria 1.510) ou CPF (Portaria 671)
  workerId     String   @map("worker_id")
  name         String?
  registration String?
  fingerprints Int      @default(0)
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, workerId])
  @@map("device_roster")
}

/// Agendamento de e-mail com resumo (faltas, atrasos, ajustes pendentes, equipamentos sem comunicação).
model NotificationSchedule {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String
  /// ABSENCES, LATE, PENDING_ADJUSTMENTS, PENDING_REQUESTS, DEVICES_OFFLINE
  kinds      String[]
  /// horário de envio (HH:mm, Brasília)
  time       String
  /// dias da semana (0 = domingo); vazio = todos
  weekdays   Int[]     @default([])
  recipients String[]
  active     Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, companyId])
  @@map("notification_schedules")
}

/// Aviso para os funcionários (aparece no painel e no app), com ciência registrada.
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  groupingId  String?   @map("grouping_id") @db.Uuid
  title       String
  body        String
  /// INFO, IMPORTANT
  level       String    @default("INFO")
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  requireAck  Boolean   @default(false) @map("require_ack")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  reads AnnouncementRead[]

  @@index([tenantId, startsAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

/// Aparelho liberado para o app do funcionário (código enviado por e-mail; só o hash do token fica guardado).
model AppDevice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  codeHash    String?   @map("code_hash")
  codeExpires DateTime? @map("code_expires") @db.Timestamptz(6)
  attempts    Int       @default(0)
  tokenHash   String?   @unique @map("token_hash")
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@map("app_devices")
}

/// Textos personalizados do cliente (rodapé do comprovante, mensagem no login, rodapé do espelho…).
model CustomText {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  text      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, key])
  @@map("custom_texts")
}

/// Layout de exportação para a folha de pagamento: código de evento (rubrica) de cada verba e formato do arquivo.
model PayrollLayout {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  /// verba -> código do evento no sistema de folha, ex.: {"normal":"001","ot50":"150","night":"025"}
  events         Json
  /// separador do arquivo: ";" "," "|" ou "TAB"
  separator      String    @default(";")
  /// HHMM (08:30), DECIMAL (8,50) ou MINUTES (510)
  quantityFormat String    @default("HHMM") @map("quantity_format")
  includeHeader  Boolean   @default(true) @map("include_header")
  /// MATRICULA ou CPF
  employeeKey    String    @default("MATRICULA") @map("employee_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, companyId])
  @@map("payroll_layouts")
}

/// Ciência eletrônica do espelho de ponto pelo funcionário (com o resumo e o hash do que foi visto).
model MirrorAcknowledgment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  /// SHA-256 do espelho (dias e totais) no momento da ciência
  contentHash  String   @map("content_hash")
  summary      Json
  /// AGREE (de acordo) ou DISAGREE (com ressalva)
  decision     String   @default("AGREE")
  comment      String?
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([employmentId, periodStart, periodEnd])
  @@index([tenantId, periodStart])
  @@map("mirror_acknowledgments")
}

/// Programa de registro de ponto (REP-P) por empresa: número no INPI e último NSR usado.
model RepPRegister {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  companyId  String   @unique @map("company_id") @db.Uuid
  /// número de registro do programa no INPI (17 dígitos no AFD/AEJ)
  inpiNumber String?  @map("inpi_number")
  lastNsr    BigInt   @default(0) @map("last_nsr")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("rep_p_registers")
}

/// Certificado ICP-Brasil A1 da empresa (PFX e senha cifrados) para assinar AFD do REP-P e AEJ (CAdES .p7s).
model CompanyCertificate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @unique @map("company_id") @db.Uuid
  pfxEnc       String   @map("pfx_enc")
  passwordEnc  String   @map("password_enc")
  subject      String
  issuer       String
  serialNumber String   @map("serial_number")
  notBefore    DateTime @map("not_before") @db.Timestamptz(6)
  notAfter     DateTime @map("not_after") @db.Timestamptz(6)
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_certificates")
}

/// Administradores da plataforma irrevogáveis (gatilhos no banco impedem excluir, bloquear ou rebaixar).
model PlatformProtectedAdmin {
  email String @id

  @@map("platform_protected_admins")
}

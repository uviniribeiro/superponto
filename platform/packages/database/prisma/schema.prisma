// -----------------------------------------------------------------------------
// Estrutura organizacional
// -----------------------------------------------------------------------------

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(TRIAL)
  document     String?
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  companies        Company[]
  users            User[]
  roles            Role[]
  people           Person[]
  subscriptions    Subscription[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  commServers      CommunicationServer[]
  tenantLdapConfig TenantLdapConfig?

  @@map("tenants")
}

model Company {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  legalName         String         @map("legal_name")
  tradeName         String?        @map("trade_name")
  cnpj              String?
  segment           CompanySegment @default(GENERAL)
  timezone          String         @default("America/Sao_Paulo")
  settings          Json           @default("{}")
  // Endereço (preenchido pelo CNPJ ou pelo CEP). O código IBGE define os feriados municipais.
  zipCode           String?        @map("zip_code")
  street            String?
  number            String?
  complement        String?
  district          String?
  city              String?
  state             String?
  ibgeCode          String?        @map("ibge_code")
  phone             String?
  email             String?
  /// Inscrição estadual ("ISENTO" quando não contribuinte)
  stateRegistration String?        @map("state_registration")
  /// CEI (legado) ou CNO/CAEPF: identificação da obra/atividade, usada no AFD
  cno               String?
  /// código no sistema de folha/ERP, para exportações
  externalCode      String?        @map("external_code")
  /// quando o logo mudou (vazio = sem logo); a imagem fica em company_logos
  logoUpdatedAt     DateTime?      @map("logo_updated_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  logo             CompanyLogo?
  holidayRules     CompanyHolidayRule[]
  holidayOverrides CompanyHolidayOverride[]
  units            CompanyUnit[]
  departments      Department[]
  positions        JobPosition[]
  employments      Employment[]
  schedules        WorkSchedule[]
  ruleSets         AttendanceRuleSet[]
  calendars        Calendar[]
  devices          Device[]
  certificate      CompanyCertificate?
  closings         TimeClosing[]
  approvalFlows    ApprovalFlow[]
  bankPolicy       BankPolicy?

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@map("companies")
}

model CompanyUnit {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  code      String?
  type      UnitType  @default(OFFICE)
  cnpj      String?
  address   Json?
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  geofenceM Int?      @map("geofence_m")
  timezone  String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company            @relation(fields: [companyId], references: [id])
  parent      CompanyUnit?       @relation("UnitTree", fields: [parentId], references: [id])
  children    CompanyUnit[]      @relation("UnitTree")
  groupings   GroupingUnit[]
  departments Department[]
  employments Employment[]
  devices     Device[]
  classrooms  Classroom[]
  rooms       ConsultationRoom[]
  shifts      MedicalShift[]
  teams       OperationalTeam[]

  @@unique([companyId, code])
  @@index([tenantId, companyId])
  @@map("company_units")
}

model Department {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  unitId              String?   @map("unit_id") @db.Uuid
  parentId            String?   @map("parent_id") @db.Uuid
  name                String
  code                String?
  managerEmploymentId String?   @map("manager_employment_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  unit        CompanyUnit? @relation(fields: [unitId], references: [id])
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentTree")
  sectors     Sector[]
  employments Employment[]

  @@unique([companyId, code])
  @@index([tenantId, companyId])
  @@map("departments")
}

model Sector {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  department  Department   @relation(fields: [departmentId], references: [id])
  employments Employment[]

  @@index([tenantId, departmentId])
  @@map("sectors")
}

model OperationalTeam {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  unitId                 String    @map("unit_id") @db.Uuid
  name                   String
  minMembers             Int       @default(1) @map("min_members")
  supervisorEmploymentId String?   @map("supervisor_employment_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  unit        CompanyUnit             @relation(fields: [unitId], references: [id])
  assignments OperationalAssignment[]

  @@index([tenantId, unitId])
  @@map("operational_teams")
}

// -----------------------------------------------------------------------------
// Pessoas e vínculos
// -----------------------------------------------------------------------------

model Person {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  fullName   String       @map("full_name")
  socialName String?      @map("social_name")
  email      String?
  phone      String?
  // Dados pessoais sensíveis: acesso restrito por permissão; nunca chave primária.
  cpf        String?
  pis        String?
  birthDate  DateTime?    @map("birth_date") @db.Date
  address    Json?
  photoPath  String?      @map("photo_path")
  status     PersonStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id])
  employments   Employment[]
  documents     PersonDocument[]
  registrations ProfessionalRegistration[]
  user          User?

  @@unique([tenantId, cpf])
  @@index([tenantId, fullName])
  @@map("people")
}

model PersonDocument {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  personId  String    @map("person_id") @db.Uuid
  kind      String
  number    String?
  filePath  String?   @map("file_path")
  issuedAt  DateTime? @map("issued_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId, personId])
  @@map("person_documents")
}

/// Registro em conselho profissional (CRM, COREN, CRP, CRF, CRO...).
model ProfessionalRegistration {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  council    String
  number     String
  state      String
  rqe        String?
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@unique([tenantId, council, state, number])
  @@index([tenantId, personId])
  @@map("professional_registrations")
}

model JobPosition {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  companyId String               @map("company_id") @db.Uuid
  name      String
  category  ProfessionalCategory @default(GENERAL)
  cbo       String?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?            @map("deleted_at") @db.Timestamptz(6)

  company     Company            @relation(fields: [companyId], references: [id])
  employments Employment[]
  groupings   GroupingPosition[]

  @@unique([companyId, name])
  @@index([tenantId])
  @@map("job_positions")
}

model Specialty {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  name      String
  category  ProfessionalCategory @default(PHYSICIAN)
  parentId  String?              @map("parent_id") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  parent      Specialty?            @relation("SpecialtyTree", fields: [parentId], references: [id])
  children    Specialty[]           @relation("SpecialtyTree")
  employments EmploymentSpecialty[]
  shifts      MedicalShift[]

  @@unique([tenantId, name])
  @@map("professional_specialties")
}

/// Vínculo funcional: uma pessoa pode ter vários (escolas, hospitais, contratos).
/// A matrícula é o identificador operacional, única dentro da empresa.
model Employment {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  personId       String               @map("person_id") @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  unitId         String?              @map("unit_id") @db.Uuid
  departmentId   String?              @map("department_id") @db.Uuid
  positionId     String?              @map("position_id") @db.Uuid
  registration   String
  category       ProfessionalCategory @default(GENERAL)
  contractType   ContractType         @default(CLT) @map("contract_type")
  function       String?
  status         EmploymentStatus     @default(ACTIVE)
  hiredAt        DateTime             @map("hired_at") @db.Date
  terminatedAt   DateTime?            @map("terminated_at") @db.Date
  weeklyHours    Decimal?             @map("weekly_hours") @db.Decimal(5, 2)
  supervisorId   String?              @map("supervisor_id") @db.Uuid
  ruleSetId      String?              @map("rule_set_id") @db.Uuid
  sectorId       String?              @map("sector_id") @db.Uuid
  functionId     String?              @map("function_id") @db.Uuid
  costCenterId   String?              @map("cost_center_id") @db.Uuid
  employeeTypeId String?              @map("employee_type_id") @db.Uuid
  unionId        String?              @map("union_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)

  person       Person             @relation(fields: [personId], references: [id])
  company      Company            @relation(fields: [companyId], references: [id])
  unit         CompanyUnit?       @relation(fields: [unitId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  position     JobPosition?       @relation(fields: [positionId], references: [id])
  supervisor   Employment?        @relation("Supervision", fields: [supervisorId], references: [id])
  supervised   Employment[]       @relation("Supervision")
  ruleSet      AttendanceRuleSet? @relation(fields: [ruleSetId], references: [id])
  sector       Sector?            @relation(fields: [sectorId], references: [id])
  jobFunction  JobFunction?       @relation(fields: [functionId], references: [id])
  costCenter   CostCenter?        @relation(fields: [costCenterId], references: [id])
  employeeType EmployeeType?      @relation(fields: [employeeTypeId], references: [id])
  laborUnion   LaborUnion?        @relation(fields: [unionId], references: [id])

  history                EmploymentHistory[]
  specialties            EmploymentSpecialty[]
  scheduleAssignments    ScheduleAssignment[]
  scheduleOverrides      ScheduleOverride[]
  allowances             Allowance[]
  leaves                 Leave[]
  onCallPeriods          OnCallPeriod[]
  overtimeAuthorizations OvertimeAuthorization[]
  timeRecords            TimeRecord[]
  calculations           TimeCalculation[]
  bankAccount            BankHourAccount?
  occurrences            AttendanceOccurrence[]
  requests               TimeRequest[]
  deviceIdentifiers      DeviceIdentifier[]
  biometrics             BiometricTemplate[]
  groupings              GroupingEmployment[]
  teachingAssignments    TeachingAssignment[]
  shiftAssignments       MedicalShiftAssignment[]
  availability           ProfessionalAvailability[]
  operationalAssignments OperationalAssignment[]
  accessEvents           AccessEvent[]

  @@unique([companyId, registration])
  @@index([tenantId, personId])
  @@index([tenantId, companyId, status])
  @@index([tenantId, unitId])
  @@map("employment_relationships")
}

/// Histórico funcional: cada alteração relevante do vínculo (cargo, unidade, jornada, situação).
model EmploymentHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employmentId String   @map("employment_id") @db.Uuid
  field        String
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  effectiveAt  DateTime @map("effective_at") @db.Date
  reason       String?
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employment Employment @relation(fields: [employmentId], references: [id])

  @@index([tenantId, employmentId, effectiveAt])
  @@map("employment_history")
}

model EmploymentSpecialty {
  employmentId String @map("employment_id") @db.Uuid
  specialtyId  String @map("specialty_id") @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid

  employment Employment @relation(fields: [employmentId], references: [id])
  specialty  Specialty  @relation(fields: [specialtyId], references: [id])

  @@id([employmentId, specialtyId])
  @@map("employment_specialties")
}

// -----------------------------------------------------------------------------
// Jornadas, escalas e calendário
// -----------------------------------------------------------------------------

/// Regras de apuração (tolerâncias, extras, noturno, banco de horas) por empresa/vínculo.
model AttendanceRuleSet {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  isDefault Boolean   @default(false) @map("is_default")
  rules     Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company        @relation(fields: [companyId], references: [id])
  employments Employment[]
  schedules   WorkSchedule[]

  @@index([tenantId, companyId])
  @@map("attendance_rule_sets")
}

/// Jornada/escala modelo. Para escalas cíclicas (12x36, 6x1, rotativas), `cycle` define a sequência.
model WorkSchedule {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  companyId            String       @map("company_id") @db.Uuid
  name                 String
  /// código usado nas integrações e na escala agendada (Átomo: "código do horário")
  code                 String?
  type                 ScheduleType
  weeklyMinutes        Int?         @map("weekly_minutes")
  cycleDays            Int?         @map("cycle_days")
  cycle                Json?
  ruleSetId            String?      @map("rule_set_id") @db.Uuid
  /// feriado vira folga; falso = o dia segue a escala (12x36, plantões)
  considerHolidays     Boolean      @default(true) @map("consider_holidays")
  /// hora in itinere somada à jornada nos dias trabalhados (minutos)
  inItinereMinutes     Int          @default(0) @map("in_itinere_minutes")
  /// mobilidade de jornada: entrada pode variar até N minutos (a saída acompanha)
  entryMobilityMinutes Int          @default(0) @map("entry_mobility_minutes")
  /// mobilidade de intervalo: o intervalo pode começar até N minutos antes/depois
  breakMobilityMinutes Int          @default(0) @map("break_mobility_minutes")
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)

  company     Company              @relation(fields: [companyId], references: [id])
  ruleSet     AttendanceRuleSet?   @relation(fields: [ruleSetId], references: [id])
  days        WorkScheduleDay[]
  assignments ScheduleAssignment[]

  /// nome único por empresa sem diferenciar maiúsculas (índice parcial na migração)
  @@index([companyId])
  @@index([tenantId])
  @@map("work_schedules")
}

/// Dia de uma jornada: dia da semana (0-6) para jornadas semanais ou posição no ciclo.

{
  "name": "@superponto/agent",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Agente local do SuperPonto: fala com os relógios na rede do cliente e com a API (só conexões de saída).",
  "bin": { "superponto-agent": "./dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --experimental-strip-types src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@superponto/rep-protocols": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}

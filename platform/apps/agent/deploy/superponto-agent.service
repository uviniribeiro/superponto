[Unit]
Description=SuperPonto - agente local dos relógios de ponto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superponto
Environment=SUPERPONTO_AGENT_CONFIG=/etc/superponto/agent.json
ExecStart=/usr/bin/node /opt/superponto-agent/dist/main.js
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/superponto
PrivateTmp=true

[Install]
WantedBy=multi-user.target

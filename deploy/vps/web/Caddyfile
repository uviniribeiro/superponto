# Proxy do PontoMax: um único domínio serve o app web e a API.
#   https://APP_DOMAIN/            -> app web (SPA)
#   https://APP_DOMAIN/auth/v1/... -> Supabase Auth  (idem rest, realtime, storage, functions)
# Certificado HTTPS emitido e renovado automaticamente pelo Let's Encrypt.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}

	@api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /functions/v1/* /graphql/v1*
	handle @api {
		reverse_proxy api-gw:8000 {
			# IP real do cliente, usado pelo agent-gateway para liberar só o servidor de comunicação.
			header_up X-Pontomax-Client-IP {client_ip}
			flush_interval -1
		}
	}

	# Instaladores do robô de comunicação e APKs publicados em public/downloads.
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

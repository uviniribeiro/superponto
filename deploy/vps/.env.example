# =====================================================================
# PontoMax — configuração da VPS principal
# Gerado por ./install.sh. Guarde uma cópia segura: sem estas chaves
# não é possível restaurar o acesso aos dados.
# =====================================================================

# ---------- Domínio e HTTPS ----------
# Domínio público do sistema (DNS tipo A apontando para o IPv4 desta VPS)
APP_DOMAIN=ponto.suaempresa.com.br
# E-mail para avisos do Let's Encrypt
ACME_EMAIL=ti@suaempresa.com.br
# Endereço servido pelo Caddy (padrão = APP_DOMAIN). Use http://:80 só para testes sem domínio.
#SITE_ADDRESS=

# ---------- Servidor de comunicação ----------
# IPv4 público do servidor dedicado de comunicação (vários separados por vírgula).
# Quando preenchido, só esses IPs conseguem usar o agent-gateway.
COMM_SERVER_IPS=

# ---------- Segredos (gerados automaticamente) ----------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
DASHBOARD_USERNAME=pontomax
DASHBOARD_PASSWORD=

# ---------- E-mail (recuperação de senha e alertas) ----------
SMTP_ADMIN_EMAIL=nao-responda@suaempresa.com.br
SMTP_HOST=smtp.suaempresa.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=PontoMax
# Relatórios/alertas por e-mail das funções (opcional, https://resend.com)
RESEND_API_KEY=

# ---------- Integrações opcionais ----------
# IA para reconhecimento facial e assistente (API compatível com OpenAI; padrão Google Gemini)
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# WhatsApp via Z-API
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Origens extras liberadas no CORS das funções (separadas por vírgula)
EXTRA_ALLOWED_ORIGINS=

# ---------- Backups ----------
BACKUP_KEEP_DAYS=14

# =====================================================================
# Valores internos do Supabase — normalmente não precisam ser alterados
# =====================================================================
SUPABASE_PUBLIC_URL=https://${APP_DOMAIN}
API_EXTERNAL_URL=https://${APP_DOMAIN}/auth/v1
SITE_URL=https://${APP_DOMAIN}
ADDITIONAL_REDIRECT_URLS=https://${APP_DOMAIN}/**,https://localhost/**,capacitor://localhost/**
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=pontomax
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=PontoMax
STUDIO_DEFAULT_PROJECT=PontoMax
OPENAI_API_KEY=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=
FUNCTIONS_VERIFY_JWT=false
FUNCTIONS_MEMORY_LIMIT=2g
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
IMGPROXY_AUTO_WEBP=true
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER
